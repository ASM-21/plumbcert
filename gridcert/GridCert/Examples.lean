/-
# GridCert.Examples

Generated by `python -m gridcert`. Do not edit by hand: regenerate from the JSON
study file instead.

Every sensitivity row below is tied back to the network equations at the
dispatch that binds it, so nothing here rests on a PTDF or LODF being correct
because some other program said so.
-/
import GridCert

set_option autoImplicit false

namespace GridCert
namespace Examples

/-! ## The study network

Buses: 0=A, 1=B, 2=C, 3=D, 4=E. Slack at bus 0 (A).

* line 0: A-B, susceptance 36, rating 400 MW
* line 1: A-D, susceptance 33, rating 400 MW
* line 2: A-E, susceptance 156, rating 400 MW
* line 3: B-C, susceptance 93, rating 400 MW
* line 4: C-D, susceptance 34, rating 400 MW
* line 5: D-E, susceptance 34, rating 240 MW
-/

def studyNet : Network :=
  [⟨0, 1, 36⟩, ⟨0, 3, 33⟩, ⟨0, 4, 156⟩, ⟨1, 2, 93⟩, ⟨2, 3, 34⟩, ⟨3, 4, 34⟩]

/-! ### A-E base case — within rating

Flow ranges over [-227.8, 260.2] MW against a ±400 MW rating, a margin of +139.8 MW. Row entries are the sensitivity times 18523566, so the 400 MW rating is the integer 7409426400.
-/

def aEBaseCaseRow : Row :=
  [0, -2795208, -3877224, -6836856, -16432260]

def aEBaseCaseBox : Box :=
  [⟨-2000, 2000⟩, ⟨-330, -270⟩, ⟨-300, -200⟩, ⟨-400, 120⟩, ⟨0, 300⟩]

def aEBaseCaseLimit : Int := 7409426400

theorem aEBaseCaseBoxWf : Box.Wf aEBaseCaseBox = true := by decide

/-- One exact angle solution per bus: a unit injection there, withdrawn at the
slack, scaled by 18523566. -/
def aEBaseCaseAngles : List Angles :=
  [[0, 0, 0, 0, 0],
   [0, 345113, 279527, 100130, 17918],
   [0, 279527, 387731, 138890, 24854],
   [0, 100130, 138890, 244910, 43826],
   [0, 17918, 24854, 43826, 105335]]

/-- **The sensitivity row is derived, not asserted.** Every entry is checked
against a zero-residual solution of the network equations for a unit injection at
that bus. Nothing here trusts an external power flow program. -/
theorem aEBaseCaseRowCertified :
    RowCertified studyNet ⟨0, 4, 156⟩ aEBaseCaseRow aEBaseCaseAngles
      5 0 18523566 = true := by decide

theorem aEBaseCaseScreens : screen aEBaseCaseRow aEBaseCaseBox aEBaseCaseLimit = true := by decide

/-- **No dispatch in the box overloads this branch.** The dispatch is
universally quantified, so this covers the whole operating envelope rather than
a list of sampled cases. -/
theorem aEBaseCaseSafe (q : Dispatch) (hq : Mem q aEBaseCaseBox = true) :
    -aEBaseCaseLimit ≤ dot aEBaseCaseRow q ∧ dot aEBaseCaseRow q ≤ aEBaseCaseLimit :=
  screen_sound aEBaseCaseScreens hq

