theorem aDWithABOutRowCertified :
    RowCertified aDWithABOutNet ⟨0, 3, 33⟩ aDWithABOutRow aDWithABOutAngles
      5 0 6099498 = true := by decide

/-- **This branch is overloaded, and here is the dispatch that does it.** A
failing screen is not a maybe: the witness lies inside the box and really does
exceed the rating. -/
theorem aDWithABOutViolates :
    Mem (argUpper aDWithABOutRow aDWithABOutBox) aDWithABOutBox = true ∧ ¬ (dot aDWithABOutRow (argUpper aDWithABOutRow aDWithABOutBox) ≤ aDWithABOutLimit) :=
  screen_complete_hi (by decide) aDWithABOutBoxWf (by decide)

/-- The binding dispatch in MW. The slack entry is whatever the box
allows: its sensitivity coefficient is zero by construction, so the slack's
own output cannot move this flow. Physically it absorbs 1030 MW here. -/
def aDWithABOutWorst : Dispatch :=
  [-2000, -330, -300, -400, 0]

theorem aDWithABOutWorstIsBinding :
    argUpper aDWithABOutRow aDWithABOutBox = aDWithABOutWorst := by decide

