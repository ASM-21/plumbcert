/-! ### A day with no carbon signal

When intensity barely moves, the optimal schedule saves almost nothing and the ratio bound collapses toward one. Worth having in the library: a scheduler that reports large savings on a day like this is reporting a bug.

Horizon 12 slots, load needs 3. Intensities in kg CO2 per MWh, allowed range [419, 422], so a forecast-free policy can promise no better than a factor of 1.01 (`online_ratio`, and tight by `online_ratio_tight`). -/

def flatProfileProfile : Profile :=
  [420, 421, 419, 420, 422, 421, 420, 419, 421, 420, 422, 420]

def flatProfileFeasible : Mask :=
  [true, true, true, true, true, true, true, true, true, true, true, true]

def flatProfile : Mask :=
  [true, false, true, false, false, false, false, true, false, false, false, false]

/-- The threshold certificate: every occupied slot is at or below 420,
every allowed but unoccupied slot is at or above it. -/
theorem flatProfile_certified :
    Certified flatProfile flatProfileFeasible flatProfileProfile 420 = true := by decide

/-- **Optimal.** No allowed schedule running the load for 3 slots
costs less. The rival is arbitrary, so this rules out every alternative
schedule, not just the ones some algorithm would consider. -/
theorem flatProfile_optimal (alt : Mask) (halt : Sub alt flatProfileFeasible = true)
    (hcount : count flatProfile = count alt) :
    cost flatProfile flatProfileProfile ≤ cost alt flatProfileProfile :=
  certified_optimal flatProfile_certified halt hcount

theorem flatProfile_cost : cost flatProfile flatProfileProfile = 1258 := by decide

def flatProfileRunNow : Mask :=
  [true, true, true, false, false, false, false, false, false, false, false, false]

/-- The run-immediately baseline is not an asserted mask: it is what
`earliest` produces from the feasibility window. -/
theorem flatProfileRunNow_isEarliest :
    flatProfileRunNow = earliest flatProfileFeasible 3 := by decide

/-- Against the run now baseline: 1260 down to 1258, a saving of 2 (0.2%). The inequality is proved;
the percentage is arithmetic on the two proved costs. -/
theorem flatProfile_beatsRunNow :
    0 ≤ cost flatProfileRunNow flatProfileProfile - cost flatProfile flatProfileProfile :=
  savings_certified flatProfile_certified (by decide) (by decide)

